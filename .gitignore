# Virtual Environment
venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Data (DVC will track these separately)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/raw/*.dvc
!data/processed/*.dvc

# MLflow
# Ignore the whole mlruns/ folder (it gets big), BUT keep the one model's
# artifacts that the Docker image needs to serve predictions. Without this
# exception the CI build on GitHub fails: the runner never receives the model.
# NOTE: git can't re-include a file if a PARENT dir is excluded, so we ignore
# each level's *contents* (dir/*) and re-include (!) the next dir down.
# Stray mlruns/ created when running notebooks — not part of the image
notebooks/mlruns/

mlruns/*
!mlruns/1/
mlruns/1/*
!mlruns/1/models/
mlruns/1/models/*
!mlruns/1/models/m-ece3b833e50d4df796a38d89b5bf2674/

# Environment variables
.env

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
