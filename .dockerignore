# ==================== .dockerignore ====================
# Keep the build context small and the image lean.
# Anything listed here is NOT sent to the Docker daemon / image.

# Virtual environment (rebuilt inside the image)
venv/
.venv/

# Data — 2.7GB, not needed to SERVE the model (only to train it)
data/

# Git
.git/
.gitignore
.dvc/
.dvcignore

# Notebooks & experiments (not needed at serving time)
notebooks/
mlruns/
# ...but DO keep the one trained model's artifacts (the Dockerfile copies
# this folder into the image and loads it via MODEL_URI).
!mlruns/1/
!mlruns/1/models/
!mlruns/1/models/m-ece3b833e50d4df796a38d89b5bf2674/
!mlruns/1/models/m-ece3b833e50d4df796a38d89b5bf2674/artifacts/
!mlruns/1/models/m-ece3b833e50d4df796a38d89b5bf2674/artifacts/**

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# Tests (not needed in the serving image)
tests/

# Optuna study databases (and mlflow.db — no longer copied into the image,
# the model is loaded directly via MODEL_URI instead of the registry)
*.db

# Docs & meta
docs/
*.md
!README.md
LICENSE

# OS / IDE junk
.DS_Store
.vscode/
.idea/

# CI file (belongs to the repo, not the image)
.github/
